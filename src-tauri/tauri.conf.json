{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ai0-video-creator",
  "version": "0.1.0",
  "identifier": "site.ai0.ai0-video-creator",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ai0-video-creator",
        "width": 1280,
        "height": 768
      }
    ],
    "security": {      
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data: http: https:; media-src 'self' asset: https://asset.localhost blob: http: https:; connect-src 'self' ws: wss: http: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval';",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*.png",
          "**/*.jpg",
          "**/*.mp4",
          "**/*.mp3",
          "**/*.wav"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}