{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "bundle": {
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "permissions": [
    "core:default",
    "opener:default",
    "fs:scope-data",
    "fs:read-all",
    "shell:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "dialog:default",
    "http:allow-fetch",
    "fs:allow-app-write",
    "fs:allow-app-write-recursive",
    "fs:allow-appconfig-read",
    "fs:allow-appcache-read",
    "fs:default",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "fs:allow-resource-read",
    "fs:allow-app-read",
    "core:webview:default",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "**/*"
        }       
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "**/*"
        },
        {
          "path": "/**"
        },
        {
          "path": "/**/*"
        }        
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "**/*"
        },
        {
          "path": "/**"
        },
        {
          "path": "/**/*"
        }
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "**/*"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "**/*"
        },
        {
          "path": "/**"
        },
        {
          "path": "/**/*"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://127.0.0.1:8188/*"
        },
        {
          "url": "http://127.0.0.1:4002/*"
        },
        {
          "url": "http://localhost:8188/*"
        }
      ]
    },
    
    "log:default"
  ]
}