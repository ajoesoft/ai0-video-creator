{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:resources:default",
    "core:webview:default",
    "fs:scope-data",
    "fs:read-all",
    "opener:default",
    "shell:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "dialog:default",
    "http:allow-fetch",
    "fs:allow-app-write",
    "fs:allow-app-write-recursive",
    "fs:allow-appconfig-read",
    "fs:allow-appcache-read",
    "fs:default",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "fs:allow-resource-read",
    "fs:allow-app-read",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "**/*"
        },
        {
          "path": "/**"
        },
        {
          "path": "/**/*"
        },
        {
          "path": "/data/**"
        },
        {
          "path": "/data/**/*"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "**/*"
        },
        {
          "path": "/**"
        },
        {
          "path": "/**/*"
        },
        {
          "path": "/data/**"
        },
        {
          "path": "/data/**/*"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "**/*"
        },
        {
          "path": "/**"
        },
        {
          "path": "/**/*"
        },
        {
          "path": "/data/**"
        },
        {
          "path": "/data/**/*"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "**/*"
        },
        {
          "path": "/**"
        },
        {
          "path": "/**/*"
        },
        {
          "path": "/data/**"
        },
        {
          "path": "/data/**/*"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://127.0.0.1:8188/*"
        },
        {
          "url": "http://localhost:8188/*"
        }
      ]
    },
    
    "log:default"
  ]
}