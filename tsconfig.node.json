{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "noUnusedLocals": false,   // 👈 允许存在未使用的局部变量
    "noUnusedParameters": false // 👈 允许存在未使用的函数参数
  },
  "include": ["vite.config.ts"]
}
